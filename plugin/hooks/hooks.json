{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/reviewhub --version >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 120
          },
          {
            "type": "command",
            "command": "REVIEWHUB_CACHED_ONLY=1 \"${CLAUDE_PLUGIN_ROOT}\"/bin/reviewhub update-check --for plugin --hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pr-created.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
