{
  "name": "reviewhub-extension",
  "version": "0.7.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "ReviewHub browser extension: review agent-authored GitHub pull requests by what matters.",
  "type": "module",
  "scripts": {
    "wasm": "../scripts/build-wasm.sh",
    "dev": "vite build --watch --mode development",
