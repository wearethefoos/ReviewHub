        {
          "kind": "security",
          "start": 14,
          "end": 15,
          "title": "Flag-off responses reveal the endpoint exists",
          "detail": "The 404 is returned after `requireMerchant`, so unauthenticated callers get 401 and can tell the route exists. Low impact while the flag is temporary.",
          "severity": "info",
          "ref": "security-flag-404"
        },
        {
          "kind": "deviation",
          "start": 14,
          "end": 14,
          "title": "Endpoint is `POST /orders/:orderId/refunds`, not `PUT /refunds/:orderId`",
          "detail": "An order can now have several partial refunds, so each call creates a resource rather than replacing one. `PUT` keyed by order id would make a second partial refund overwrite the first. Retry safety comes from the `Idempotency-Key` header instead.",
          "ref": "deviation-endpoint-shape"
        },
        {
          "kind": "security",
          "start": 24,
          "end": 24,
          "title": "Merchants can refund orders that belong to other merchants",
          "detail": "`requireMerchant` authenticates the caller, but nothing checks that the order belongs to that merchant. Any merchant who can guess an order id can refund it.",
          "severity": "high",
          "ref": "security-idor"
        },
        {
          "kind": "decision",
          "start": 28,
          "end": 28,
          "title": "Business rule violations return 409",
          "detail": "Return 409 Conflict with an error code. 422 is reserved for invalid bodies.",
          "ref": "decision-conflict-status"
        }
      ]
    },
