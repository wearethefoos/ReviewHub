          "kind": "security",
          "start": 25,
          "end": 25,
          "title": "Idempotency keys aren't scoped to the merchant",
          "detail": "The Redis key only contains the client-supplied idempotency key. If two merchants send the same key, the second gets the first merchant's refund back, including its order id and amount.",
          "severity": "medium",
          "ref": "security-idem-scope"
        },
        {
          "kind": "decision",
          "start": 25,
          "end": 26,
          "title": "Idempotency keys are stored in Redis with a 24 hour TTL",
          "detail": "Cache the created refund in Redis under the idempotency key for 24 hours.",
          "ref": "decision-idempotency-store"
        },
