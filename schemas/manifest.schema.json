{
  "$defs": {
    "Agent": {
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "sessionUrl": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Alternative": {
      "properties": {
        "description": {
          "type": "string"
        },
        "prompt": {
          "description": "A ready-to-use prompt that asks an agent to switch to this alternative.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "tradeoffs": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title",
        "description"
      ],
      "type": "object"
    },
    "Decision": {
      "description": "A question the prompt left open, and how the agent answered it.",
      "properties": {
        "alternatives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "type": "array"
        },
        "chosen": {
          "description": "What the agent decided.",
          "type": "string"
        },
        "context": {
          "description": "The question that needed answering and why the prompt did not settle it.",
          "type": "string"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileRef"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable identifier, unique within its list.",
          "minLength": 1,
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/Impact",
          "default": "low"
        },
        "rationale": {
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "context",
        "chosen",
        "rationale"
      ],
      "type": "object"
    },
    "Deviation": {
      "description": "A place where the delivery differs from what was asked.",
      "properties": {
        "delivered": {
          "description": "What was delivered instead.",
          "type": "string"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileRef"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable identifier, unique within its list.",
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "description": "Why the agent deviated.",
          "type": "string"
        },
        "requested": {
          "description": "What the prompt asked for.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DeviationSeverity",
          "default": "minor"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "requested",
        "delivered",
        "reason"
      ],
      "type": "object"
    },
    "DeviationSeverity": {
      "enum": [
        "minor",
        "major"
      ],
      "type": "string"
    },
    "Effort": {
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "type": "string"
    },
    "FileNote": {
      "properties": {
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "reviewHint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewHint"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/FileRole"
        }
      },
      "required": [
        "path",
        "role"
      ],
      "type": "object"
    },
    "FileRef": {
      "description": "A file, optionally narrowed to a line range, that an item is about.",
      "properties": {
        "lines": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "description": "Repository-relative file path.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FileRole": {
      "enum": [
        "core",
        "supporting",
        "test",
        "config",
        "docs",
        "generated",
        "mechanical"
      ],
      "type": "string"
    },
    "Gap": {
      "description": "Something the agent could not validate.",
      "properties": {
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effort"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileRef"
          },
          "type": "array"
        },
        "howToValidate": {
          "description": "Concrete steps for whoever closes the gap.",
          "type": "string"
        },
        "id": {
          "description": "Stable identifier, unique within its list.",
          "minLength": 1,
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/Owner",
          "default": "human"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "why": {
          "description": "Why the agent could not validate this.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "why",
        "howToValidate"
      ],
      "type": "object"
    },
    "Impact": {
      "description": "How costly it is to get a decision wrong or change it later.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "LineRange": {
      "description": "Inclusive `[start, end]` line range in the new version of a file.",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "Owner": {
      "description": "Who should do something.",
      "enum": [
        "human",
        "agent",
        "ci",
        "ops"
      ],
      "type": "string"
    },
    "Prompt": {
      "properties": {
        "followUps": {
          "default": [],
          "description": "Later user messages that changed the scope, verbatim.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "original": {
          "description": "The user's request, verbatim.",
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "description": "Link to the issue or conversation the prompt came from.",
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "original"
      ],
      "type": "object"
    },
    "ReportVersion": {
      "description": "Report format version.",
      "enum": [
        "1"
      ],
      "type": "string"
    },
    "ReviewHint": {
      "description": "The agent's own suggestion. ReviewHub treats \"skip\" as a claim, not a verdict.",
      "enum": [
        "must-review",
        "skim",
        "skip"
      ],
      "type": "string"
    },
    "RolloutStep": {
      "description": "Something that has to happen outside the diff for the change to ship.",
      "properties": {
        "blocking": {
          "default": false,
          "type": "boolean"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "id": {
          "description": "Stable identifier, unique within its list.",
          "minLength": 1,
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/Owner",
          "default": "human"
        },
        "prompt": {
          "description": "Prompt to hand this step to an agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/RolloutWhen",
          "default": "before-merge"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "RolloutWhen": {
      "enum": [
        "before-merge",
        "after-merge",
        "after-deploy"
      ],
      "type": "string"
    },
    "Validation": {
      "description": "A check the agent actually ran.",
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "description": "Short excerpt of output proving the result.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileRef"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable identifier, unique within its list.",
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ValidationKind"
        },
        "result": {
          "$ref": "#/$defs/ValidationResult"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "result"
      ],
      "type": "object"
    },
    "ValidationKind": {
      "enum": [
        "unit-test",
        "integration-test",
        "e2e-test",
        "typecheck",
        "lint",
        "build",
        "manual",
        "benchmark",
        "other"
      ],
      "type": "string"
    },
    "ValidationResult": {
      "enum": [
        "passed",
        "failed",
        "partial",
        "skipped"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Written by the agent that authored a pull request: the context a reviewer\nneeds but cannot get from the diff.",
  "properties": {
    "agent": {
      "$ref": "#/$defs/Agent"
    },
    "decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "type": "array"
    },
    "deviations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Deviation"
      },
      "type": "array"
    },
    "files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FileNote"
      },
      "type": "array"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "type": "array"
    },
    "prompt": {
      "$ref": "#/$defs/Prompt"
    },
    "rollout": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RolloutStep"
      },
      "type": "array"
    },
    "summary": {
      "description": "What was delivered, in a few sentences.",
      "type": "string"
    },
    "validation": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Validation"
      },
      "type": "array"
    },
    "version": {
      "$ref": "#/$defs/ReportVersion"
    }
  },
  "required": [
    "version",
    "agent",
    "prompt",
    "summary"
  ],
  "title": "ReviewManifest",
  "type": "object"
}
