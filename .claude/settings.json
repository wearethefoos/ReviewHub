{
  "enabledPlugins": {
    "reviewhub@reviewhub": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/reviewhub/pr-created.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|mcp__github__create_pull_request"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/reviewhub/session-start.sh",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ]
  }
}
